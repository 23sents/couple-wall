<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Only TLS: the relay is reachable over https only, and nothing else may be reached in clear text. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
